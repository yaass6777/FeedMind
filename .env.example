# FeedMind environment configuration — TEMPLATE
#
# Copy to `.env` for local development and replace the placeholder values.
# Never commit `.env`. In Docker, these variables are supplied by Docker Compose.

# --- Application ---
APP_NAME=FeedMind
# One of: development, test, production
APP_ENV=development
DEBUG=false

# --- Security ---
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Database (PostgreSQL via psycopg 3) ---
# Required format: postgresql+psycopg://USER:PASSWORD@HOST[:PORT]/DATABASE
DATABASE_URL=postgresql+psycopg://feedmind:change-me@localhost:5432/feedmind

# --- PostgreSQL container (compose.yaml) ---
# Used by `docker compose up -d db` to initialize the database on first start.
# Must match the user, password and database name in DATABASE_URL above.
POSTGRES_DB=feedmind
POSTGRES_USER=feedmind
POSTGRES_PASSWORD=change-me

# --- CORS ---
# Required. Comma-separated list of allowed frontend origins, each in the form
# http(s)://host[:port]. Paths, query strings, credentials and wildcards are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
